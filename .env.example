# ---------------------------------------------------------------
# Backend selection: "mock" (no server, BroadcastChannel multiplayer)
# or "supabase" (real project). Defaults to mock when unset.
# ---------------------------------------------------------------
VITE_BACKEND=mock

# --- Fill these in when the Supabase project exists -------------
VITE_SUPABASE_URL=
# Newer projects issue `sb_publishable_...`; older ones a legacy `anon` JWT.
# Either variable name works -- set whichever your project gives you.
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# --- Cloudflare Turnstile ---------------------------------------
# These are Cloudflare's official always-pass TEST keys.
# Swap for real keys before any public launch.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Server-side only, used by the verify-turnstile Edge Function:
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
